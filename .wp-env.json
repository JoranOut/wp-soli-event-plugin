{
  "core": "https://wordpress.org/wordpress-7.0.4.zip",
  "port": 8900,
  "plugins": ["."],
  "config": {
    "WP_DEBUG": true
  },
  "mappings": {
    ".wp-env-script.sh": "./.wp-env-script.sh"
  },
  "lifecycleScripts": {
    "afterStart": "wp-env run cli bash /var/www/html/.wp-env-script.sh && wp-env run tests-cli bash /var/www/html/.wp-env-script.sh"
  },
  "env": {
    "tests": {
      "port": 8901,
      "config": {
        "WP_DEBUG": true,
        "WP_DEBUG_LOG": false,
        "WP_DEBUG_DISPLAY": true,
        "SCRIPT_DEBUG": true
      }
    }
  }
}
